# Copia este archivo como .env (en la MISMA carpeta que vidup.py)
# y reemplaza los valores de ejemplo por los tuyos.
# No pongas comillas ni espacios alrededor del signo =

# Token que te da @BotFather al crear el bot (formato: 123456789:AAE...)
TELEGRAM_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del chat donde se envían las notificaciones (número, puede ser negativo en grupos)
TELEGRAM_CHAT_ID=123456789

# Opcional: URL de Neon si usas base de datos en la nube
# NEON_DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
